{
  "manifest_version": 3,
  "name": "新标签页",
  "version": "1.0.0",
  "description": "内置自定义搜索首页的新标签页：可切换搜索引擎、自定义壁纸与 Logo。",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
